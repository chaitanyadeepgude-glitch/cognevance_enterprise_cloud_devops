# ==============================================================================
# Kubernetes Secret Template (Example)
# IMPORTANT: Never commit actual unencrypted secrets to source control.
# Copy this file to secret.yaml locally, replace base64 values, and apply:
# kubectl apply -f secret.yaml
#
# Generate base64: echo -n 'my-strong-secret' | base64
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: enterprise-devops-secret
  namespace: devops-enterprise
  labels:
    app: enterprise-devops-app
type: Opaque
data:
  # Base64 encoded placeholder values (echo -n "devops-production-secret-key-2026" | base64)
  SECRET_KEY: ZGV2b3BzLXByb2R1Y3Rpb24tc2VjcmV0LWtleS0yMDI2
  API_SALT: ZGV2b3BzLXNhbHQtdmFsdWUtZXhhbXBsZQ==
